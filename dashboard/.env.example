# Release-02A: isolate dashboard Next static assets from public /_next (LiteSpeed routes prefix to :3001)
DASHBOARD_ASSET_PREFIX=/dashboard-next

NEXT_PUBLIC_DASHBOARD_MODE=live
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_ALLOW_MUTATIONS=false
# Optional: Laravel origin when Next dev server runs separately (e.g. http://127.0.0.1:8000)
NEXT_PUBLIC_LARAVEL_API_BASE=
NEXT_PUBLIC_DATA_SOURCE_UNAVAILABLE=false
NEXT_PUBLIC_FIXTURE_REVISION=dash-11

DASHBOARD_PREVIEW_ENABLED=true
DASHBOARD_PREVIEW_ALLOW_LIVE_DATA=false
DASHBOARD_PREVIEW_ALLOW_MUTATIONS=false
