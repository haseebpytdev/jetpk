{
  "name": "jetpk-public-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "start:smoke": "next start -H 127.0.0.1 -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:smoke": "npm run build && playwright test -c playwright.config.ts",
    "test:public-content": "npm run build && playwright test tests/public-content.spec.ts -c playwright.config.ts",
    "test:public-regression": "npm run build && playwright test tests/public-content.spec.ts tests/public-shell.spec.ts tests/booking-lookup-turnstile.spec.ts tests/auth.spec.ts tests/homepage.spec.ts tests/customer-dashboard.spec.ts tests/agent-dashboard.spec.ts tests/group-ticketing.spec.ts tests/search-laravel-handoff.spec.ts -c playwright.config.ts",
    "audit:visual:jp-ui-01": "node scripts/capture-jp-ui-01.mjs",
    "audit:visual:jp-ui-02": "node scripts/capture-jp-ui-02.mjs",
    "audit:visual:jp-ui-03": "node scripts/capture-jp-ui-03.mjs",
    "audit:visual:jp-ui-03a": "node scripts/capture-jp-ui-03a.mjs",
    "audit:visual:jp-ui-04": "node scripts/capture-jp-ui-04.mjs",
    "audit:visual:jp-ui-04a": "node scripts/capture-jp-ui-04a.mjs",
    "audit:visual:jp-ui-05": "node scripts/capture-jp-ui-05.mjs",
    "audit:visual:jp-ui-06": "node scripts/capture-jp-ui-06.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.9",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
