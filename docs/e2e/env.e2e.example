# Isolated full-stack auth E2E environment (PR #57).
# Copy to .env.e2e (gitignored). Do NOT copy production .env.

APP_NAME="JetPakistan E2E"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:9080

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=null
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# Dashboard Next proxy (Laravel BackOfficeDashboardController)
DASHBOARD_NEXT_SERVER_URL=http://127.0.0.1:3001
DASHBOARD_NEXT_PROXY_ENABLED=true

# Disable production-only hardening that breaks local HTTP
FORCE_HTTPS=false

# QA identity passwords — set in the process/shell only, never commit real values.
# JP_DASH_03_QA_ADMIN_PASSWORD=
# JP_DASH_03_QA_STAFF_PASSWORD=
# JP_DASH_03_QA_AGENT_PASSWORD=
# JP_DASH_03_QA_CUSTOMER_PASSWORD=

# Optional OTP demo for local login without mailbox (local E2E only)
OTP_DEMO_FIXED_ENABLED=true
OTP_DEMO_FIXED_CODE=123456
OTP_DEMO_ALLOWED_EMAILS=jp-dash-03-qa-admin@jetpakistan.pk,jp-dash-03-qa-staff@jetpakistan.pk,jp-dash-03-qa-agent@jetpakistan.pk,jp-dash-03-qa-customer@jetpakistan.pk

OTA_ACTIVE_THEME=jetpakistan
OTA_CANONICAL_CLIENT_THEME=jetpakistan

